# The production settings for deploy/compose.prod.yml. Keep the real file outside the repository, readable by its
# owner alone (chmod 600); deploy/deploy.sh creates one with a random password when it does not exist.
POSTGRES_USER=coinroost
POSTGRES_DB=coinroost
POSTGRES_PASSWORD=
# The loopback port the app is published on (default 8094).
# COINROOST_PORT=8094
# Host names a reverse proxy uses to reach /mcp, comma separated (loopback only when empty).
# COINROOST_MCP_HOSTS=
# A reverse proxy's Docker network the app joins, so the proxy reaches it as coinroost-app-1:8080 (optional; see
# deploy/compose.proxy.yml). The database never joins it.
# COINROOST_PROXY_NETWORK=
# `open` lets the first person who reaches a fresh install make the owner account from the web; until then anyone who
# reaches it could. Only turn it on behind something that limits who reaches the app, such as an access proxy;
# otherwise make the first account with `coinroost-server invite add`.
# COINROOST_FIRST_ACCOUNT=closed
